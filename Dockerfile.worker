FROM python:3.11-slim

WORKDIR /app

# Dependências do sistema (faster-whisper precisa de compiladores e ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instala todas as deps Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código fonte
COPY . .

# PRE-BAIXA modelo Whisper base (~300MB) durante o build
# Assim o runtime não precisa baixar. Modelo fica em /app/whisper_models
ENV WHISPER_DOWNLOAD_ROOT=/app/whisper_models
RUN python -c "from faster_whisper import WhisperModel; m = WhisperModel('base', device='cpu', compute_type='default', download_root='/app/whisper_models'); print('Modelo Whisper base baixado com sucesso')"

# Expõe a porta (worker nao usa, mas Cloud Run exige)
EXPOSE 8080

ENV PYTHONIOENCODING=utf-8

# CMD: rodar o worker (Pub/Sub consumer)
CMD ["python", "worker.py"]