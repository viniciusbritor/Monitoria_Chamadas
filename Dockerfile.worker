FROM python:3.11-slim

WORKDIR /app

# Dependências do sistema (faster-whisper precisa de compiladores e ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instala todas as deps Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código fonte
COPY . .

# PRE-BAIXA modelo Whisper base (~74MB) durante o build
# Modelo base: ~0.1x tempo real, ideal para pipeline <1min em audios tipicos
# (10/07/2026): revertido de large-v3 para base. large-v3 era 2.5x real-time,
# inviabilizando pipeline rapido. base mantem qualidade suficiente para QA.
ENV WHISPER_DOWNLOAD_ROOT=/app/whisper_models
RUN python -c "from faster_whisper import WhisperModel; m = WhisperModel('base', device='cpu', compute_type='int8', download_root='/app/whisper_models'); print('Modelo Whisper base baixado com sucesso')"

# Expõe a porta (worker nao usa, mas Cloud Run exige)
EXPOSE 8080

ENV PYTHONIOENCODING=utf-8

# CMD: rodar o worker (Pub/Sub consumer)
CMD ["python", "worker.py"]