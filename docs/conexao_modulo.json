      "branch": "test",
      "build_config": "cloudbuild-test.yaml",
      "support_contact": "viniciusbritor@gmail.com",
      "deployed_at": "2026-07-07",
      "last_revision": "monitoria-test-env-00065-gpt"
    },
    "prod": {
      "url": null,
