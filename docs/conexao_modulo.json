{
  "$schema": "https://json-schema.org/draft-07/schema",
  "module_id": "monitoria-chamadas",
  "display_name": "Monitoria de Chamadas",
  "description": "Transcricao e avaliacao QA de audios de atendimento ao cliente usando faster-whisper (PT-BR) e MiniMax M3.",
  "icon": "Headphones",
  "schema_version": "1.2.0",
  "last_updated": "2026-07-07",
  "objective": [
    "Upload de chamada (audio file)",
    "Transcricao audio -> texto",
    "Separar audio atendente e cliente",
    "Avaliar nota QA do atendente e nota NPS do cliente",
    "Categorizar motivos principais da chamada"
  ],
  "owner": "viniciusbritor@gmail.com",
  "repository": "viniciusbritor/Monitoria_Chamadas",
  "_canonical_location": "Monitoria_Chamadas_Teste/docs/conexao_modulo.json (FONTE CANONICA)",
  "_portal_consumption": "Portal clona este arquivo via cloudbuild-test.yaml step 0 (git clone https://github.com/viniciusbritor/Monitoria_Chamadas.git)",
  "variants": {
    "test": {
