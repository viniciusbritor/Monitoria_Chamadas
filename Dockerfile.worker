FROM python:3.11-slim

WORKDIR /app

# Dependências do sistema (faster-whisper precisa de compiladores e ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instala todas as deps Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código fonte
COPY . .

# PRE-BAIXA modelo Whisper large-v3 (~1.5GB) durante o build
# Assim o runtime não precisa baixar. Modelo fica em /app/whisper_models
# NEW (09/07/2026 - Batch/Standalone): trocado de 'base' (74MB) para 'large-v3' (~1.5GB).
# large-v3 e' ~2x mais rapido em CPU que 'base' e melhor qualidade.
ENV WHISPER_DOWNLOAD_ROOT=/app/whisper_models
RUN python -c "from faster_whisper import WhisperModel; m = WhisperModel('large-v3', device='cpu', compute_type='int8', download_root='/app/whisper_models'); print('Modelo Whisper large-v3 baixado com sucesso')"

# Expõe a porta (worker nao usa, mas Cloud Run exige)
EXPOSE 8080

ENV PYTHONIOENCODING=utf-8

# CMD: rodar o worker (Pub/Sub consumer)
CMD ["python", "worker.py"]